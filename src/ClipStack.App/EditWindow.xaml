<Window x:Class="ClipStack.App.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑条目"
        Width="440" Height="320"
        MinWidth="340" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="ToolWindow"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Editor"
                 Grid.Row="0"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="8"
                 Background="{DynamicResource CardBrush}"
                 BorderBrush="{DynamicResource EdgeBrush}"
                 BorderThickness="1"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                 SelectionBrush="{DynamicResource SelectionEdgeBrush}"
                 PreviewKeyDown="Editor_PreviewKeyDown" />

        <TextBlock x:Name="ErrorText"
                   Grid.Row="1"
                   Margin="2,8,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="Ctrl+Enter 保存，Esc 取消" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="取消" Style="{StaticResource DialogButton}" Click="Cancel_Click" />
            <Button Content="保存" Style="{StaticResource PrimaryDialogButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
