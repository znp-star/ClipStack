<Window x:Class="ClipStack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipStack.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipStack"
        Width="420" Height="520"
        MinWidth="320" MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Filter bar chip: a radio button rendered as a pill so the whole bar reads as one control. -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush"
                                        Value="{DynamicResource SelectionEdgeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- CaptionHeight 0 keeps every pixel under our own hit-testing (dragging is handled
         in code), while ResizeBorderThickness gives the panel real resize borders. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{DynamicResource PanelSurfaceBrush}"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelOffset" />
        </Border.RenderTransform>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border Grid.Row="0"
                    Height="38"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,10">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="11,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="搜索历史…"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Filter bar -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="2,0,0,8">
                <RadioButton x:Name="FilterAll"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="all"
                             Content="全部"
                             IsChecked="True"
                             Checked="FilterChip_Checked" />
                <RadioButton x:Name="FilterText"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="text"
                             Content="文本"
                             Checked="FilterChip_Checked" />
                <RadioButton x:Name="FilterLink"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="link"
                             Content="链接"
                             Checked="FilterChip_Checked" />
                <RadioButton x:Name="FilterImage"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="image"
                             Content="图片"
                             Checked="FilterChip_Checked" />
                <RadioButton x:Name="FilterFile"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="file"
                             Content="文件"
                             Checked="FilterChip_Checked" />
                <RadioButton x:Name="FilterSensitive"
                             Style="{StaticResource FilterChip}"
                             GroupName="Filter"
                             Tag="sensitive"
                             Content="敏感"
                             Checked="FilterChip_Checked" />
            </StackPanel>

            <!-- Items -->
            <Grid Grid.Row="2">
                <ListBox x:Name="ItemList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewMouseLeftButtonUp="ItemList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- The row shows selection itself; a dotted focus rectangle would be noise
                                 (focus stays in the search box anyway). -->
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Row background and the separator rule are siblings, so a
                                             selected row never paints over the rule. -->
                                        <StackPanel>
                                            <Border x:Name="RowBorder"
                                                    MinHeight="52"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,7,10,7">
                                                <Grid>
                                                    <!-- Shape, not only colour: the row that Enter will
                                                         paste carries a stripe. -->
                                                    <Border x:Name="ActiveStripe"
                                                            Width="3"
                                                            Margin="-7,1,0,1"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Stretch"
                                                            Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="1.5"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Height="1"
                                                    Margin="12,0,12,0"
                                                    Background="{DynamicResource DividerBrush}" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <!-- The pinned block sits on top; a faint tint keeps its
                                                 edge readable without a second divider. -->
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource PinnedRowBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource SelectionBrush}" />
                                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                                        Value="{DynamicResource SelectionEdgeBrush}" />
                                                <Setter TargetName="ActiveStripe" Property="Visibility"
                                                        Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ItemRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail leads the row so image entries are recognisable at a glance.
                                     Painted as a Border background (not an Image) so the corners round. -->
                                <Border Grid.Column="0"
                                        Width="56" Height="38"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        CornerRadius="4"
                                        BorderBrush="{DynamicResource EdgeBrush}"
                                        BorderThickness="1"
                                        RenderOptions.BitmapScalingMode="HighQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- At most two lines, then an ellipsis; no source, time, size or type -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Preview}"
                                           Visibility="{Binding PreviewVisibility}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           LineHeight="18"
                                           LineStackingStrategy="BlockLineHeight"
                                           MaxHeight="36" />

                                <!-- Trailing chips: the "未保存" badge marks in-memory rows, the pin
                                     control toggles pinning. Clicking either never pastes. -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0">
                                    <Border Padding="5,1"
                                            VerticalAlignment="Center"
                                            CornerRadius="3"
                                            Background="{DynamicResource BadgeBackgroundBrush}"
                                            Visibility="{Binding SensitiveBadgeVisibility}"
                                            ToolTip="只留在内存里，应用退出后消失">
                                        <TextBlock Text="未保存"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource BadgeForegroundBrush}" />
                                    </Border>

                                    <!-- Pin control: always visible on pinned rows, appears on
                                         hover for the rest. Hidden for sensitive rows, which have
                                         no record to pin. -->
                                    <Button x:Name="PinButton"
                                            Width="26" Height="26"
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            Cursor="Hand"
                                            Click="PinButton_Click"
                                            ToolTip="置顶 / 取消置顶 (Ctrl+P)"
                                            AutomationProperties.Name="置顶">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="PinHover"
                                                                    Background="Transparent"
                                                                    CornerRadius="13">
                                                                <TextBlock x:Name="PinGlyph"
                                                                           Text="&#xE718;"
                                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="PinHover" Property="Background"
                                                                            Value="{DynamicResource HoverBrush}" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter TargetName="PinGlyph" Property="Foreground"
                                                                            Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <!-- Last, so it wins: a sensitive row can never be pinned. -->
                                                    <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Text="还没有记录，复制点什么试试"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       Margin="2,8,2,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />

            <!-- Hints -->
            <DockPanel Grid.Row="4" Margin="2,8,2,0">
                <Button DockPanel.Dock="Right"
                        Content="退出"
                        Padding="6,0"
                        FontSize="11"
                        Cursor="Hand"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Quit_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextWrapping="Wrap"
                           Text="↑↓ 选择   Enter 粘贴   Ctrl+P 置顶   F2 编辑   Del 删除   Ctrl+Tab 换过滤   Esc 关闭" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
