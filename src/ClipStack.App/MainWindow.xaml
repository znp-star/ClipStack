<Window x:Class="ClipStack.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipStack.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClipStack"
        Width="420" Height="520"
        MinWidth="320" MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- CaptionHeight 0 keeps every pixel under our own hit-testing (dragging is handled
         in code), while ResizeBorderThickness gives the panel real resize borders. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{DynamicResource PanelSurfaceBrush}"
            BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1"
            CornerRadius="8"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelOffset" />
        </Border.RenderTransform>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search -->
            <Border Grid.Row="0"
                    Height="38"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,10">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="11,0"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="搜索历史…"
                               Margin="12,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Items -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ItemList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewMouseLeftButtonUp="ItemList_PreviewMouseLeftButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="RowBorder" Property="Background"
                                                        Value="{DynamicResource SelectionBrush}" />
                                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                                        Value="{DynamicResource SelectionEdgeBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ItemRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource BadgeBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Badge}"
                                               FontSize="11"
                                               Foreground="{DynamicResource BadgeForegroundBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Preview}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Thumbnail, only for image items -->
                                <Border Grid.Column="2"
                                        Width="52" Height="34"
                                        Margin="10,0,0,0"
                                        CornerRadius="4"
                                        Background="{DynamicResource BadgeBackgroundBrush}"
                                        ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Text="还没有记录，复制点什么试试"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="2,8,2,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="Collapsed" />

            <!-- Hints -->
            <DockPanel Grid.Row="3" Margin="2,8,2,0">
                <Button DockPanel.Dock="Right"
                        Content="退出"
                        Padding="6,0"
                        FontSize="11"
                        Cursor="Hand"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="Quit_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="↑↓ 选择    Enter 粘贴    Esc 关闭" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
